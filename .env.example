# Copy this file to .env for local runs (.env is in .gitignore, never commit it).
# In GitHub Actions the same values come from repository Secrets.

# Last.fm API key: register at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Snowflake account identifier, e.g. ORGNAME-ACCOUNTNAME
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=LASTFM_PIPELINE_USER
# Path to the private key created with openssl (keep it outside the repo)
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/<you>/.snowflake-keys/rsa_key.p8
